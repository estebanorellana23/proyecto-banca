@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
left to right direction
actor "Administrador" as A
rectangle "Banco UMG" {
 usecase "Iniciar sesión" as UC1
 usecase "Agregar cajero" as UC2
 usecase "Bloquear o desbloquear cajero" as UC3
 usecase "Consultar monitor y detalles" as UC4
 usecase "Consultar logs publicados" as UC5
 usecase "Cerrar sesión" as UC6
}
A -- UC1
A -- UC2
A -- UC3
A -- UC4
A -- UC5
A -- UC6
@enduml
